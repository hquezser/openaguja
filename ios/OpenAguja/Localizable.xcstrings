        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0x94 SET [0x00] déclenche l'initialisation d'usine (valeurs par défaut + drapeau persistant) — quitte l'écran QR pour le cadran, comme l'init de l'app officielle."
          }
        }
